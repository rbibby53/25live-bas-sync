# Docker secrets for docker compose. Copy to .env (gitignored) and fill in.
#   cp .env.example .env
# Passwords live ONLY here / in the environment — never in the YAML config.
# Every variable in this file is passed into the container.

# The 25Live service account (a LOCAL account, not SSO).
BAS_25LIVE_PASSWORD=

# One per BAS system that authenticates, named after the system's key in
# config.yaml, uppercased, with non-alphanumerics as underscores:
#   systems: { supervisor: ... }   ->  BAS_SYS_SUPERVISOR_PASSWORD
#   systems: { ebo_west: ... }     ->  BAS_SYS_EBO_WEST_PASSWORD
# BACnet systems need no password — the controls network is the boundary.
BAS_SYS_SUPERVISOR_PASSWORD=

# Pre-1.0 names, still honored as a per-driver fallback.
# BAS_NIAGARA_PASSWORD=
# BAS_WEBCTRL_PASSWORD=
# BAS_EBO_PASSWORD=

# Only needed if alerts.email is enabled in config.yaml.
BAS_SMTP_PASSWORD=

# Campus timezone (IANA name). Drives the container clock and the sync.
TZ=America/New_York

# Built-in daily scheduler time (24-hour, in TZ above). Clear it for one-shot
# runs: docker compose run --rm -e SYNC_AT= sync --dry-run
SYNC_AT=02:00
# Set to 1 to also run once immediately when the container starts.
SYNC_ON_START=0
